            VALUE "CompanyName",      "Wsh Project\0"
            VALUE "FileDescription",  "Wsh Terminal Emulator\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "Wsh\0"
